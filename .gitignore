*~

# ============================================================
# Terraform
# ============================================================
# Provider binaries (thủ phạm gây file 685MB!)
**/.terraform/
.terraform.lock.hcl

# Variable files (có thể chứa thông tin nhạy cảm / secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example

# State files (chứa sensitive data, lưu trên S3)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Override files (local dev only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan
tfplan

# ============================================================
# Application
# ============================================================
.gradle/
.kubernetes-manifests-*/
.skaffold-*.yaml
.venv/
*.pyc
bin/
build/
Dockerfile.pip
node_modules/
obj/
pkg/
vendor/

# ============================================================
# Credentials & Secrets (NEVER commit these)
# ============================================================
gha-creds-*.json
*.pem
*.key
.env
.env.*
!.env.example

# ============================================================
# Misc
# ============================================================
release/wi-kubernetes-manifests.yaml
